{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "SIPSorcery": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Turn": {
    "Host": "<turn-host>:3478",
    "Secret": "<turn-static-auth-secret>"
  },
  "StreamSettings": {
    "FFmpegLibPath": "public/bin",
    "TargetBitrate": 1000000,
    "Cameras": [
      {
        "Id": "camera1",
        "Name": "Camera 1",
        "RtspUrl": "rtsp://<user>:<password>@<camera-ip>/<path>"
      },
      {
        "Id": "camera2",
        "Name": "Camera 2",
        "RtspUrl": "rtsp://<user>:<password>@<camera-ip>/<path>",
        "RtspTransport": "tcp"
      }
    ]
  }
}
