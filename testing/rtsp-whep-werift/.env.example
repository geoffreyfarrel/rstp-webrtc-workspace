# Copy to .env and fill in. .env is gitignored (root .gitignore's `.env`
# pattern applies at any depth).

# Same camera as backend/appsettings.json's StreamSettings:RtspUrl.
RTSP_URL=rtsp://<user>:<password>@<camera-ip>/<path>

# Same TURN server as backend/appsettings.json's Turn section / frontend/.env.
TURN_HOST=<turn-host>:3478
TURN_USERNAME=<turn-username>
TURN_CREDENTIAL=<turn-credential>

# Same cap as backend/appsettings.json's StreamSettings:TargetBitrate (bps).
TARGET_BITRATE=100000

# Port this WHEP server listens on. Point frontend/.env's VITE_BACKEND_URL at
# http://localhost:<PORT> to swap the frontend over to this backend.
PORT=8092
