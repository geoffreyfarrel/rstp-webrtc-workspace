# Copy this file to .env and fill in your TURN server details. .env is
# gitignored.

# Base URL of the C# WHEP backend (backend/Controllers/StreamController.cs).
# Leave unset to call it through the vite.config.ts dev proxy (relative
# /Stream/whep) — required for ngrok/remote access, since an absolute
# http://localhost:5014 only resolves on the machine running the backend.
# Only set this if you're bypassing the proxy.
# VITE_BACKEND_URL=http://localhost:5014

# TURN relay used by the browser for its own ICE gathering. Only the host is
# needed here - username/credential are minted per-camera by the backend
# (GET /Stream/turn-credentials/{cameraId}, coturn's use-auth-secret scheme)
# so the shared secret never reaches client code.
VITE_TURN_HOST=<turn-host>:3478
